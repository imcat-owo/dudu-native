    "apigroup.oauth.logoutConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out of %1$@? The token will be deleted from this phone, and chats won't be able to use it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 %1$@ 的登录？token 会从本机删掉，之后聊天就用不了它了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 %1$@ 的登錄？token 會從本機刪掉，之後聊天就用不了它了。"
          }
        }
      }
    },
    "apigroup.oauth.reNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honest note: these logins use reverse-engineered endpoints, not public APIs — they can break whenever the provider changes them. An API key is the steadier choice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "老实说：这些登录走的是逆向出来的接口，不是官方公开的，厂商一改就可能抽风。求稳的话还是用 API key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "老實說：這些登錄走的是逆向出來的接口，不是官方公開的，廠商一改就可能抽風。求穩的話還是用 API key。"
          }
        }
      }
    },
    "apigroup.oauth.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in without a key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免 Key 登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免 Key 登錄"
          }
        }
      }
    },
    "apigroup.onboardBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dudu needs a model connected to chat with you. Tap the button below and fill in the address, key and model name from your model provider — stored safely on your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嘟嘟要连上模型才能陪你聊天。点下面的按钮，把模型服务商给你的地址、钥匙和模型名填进来就行，存在你手机里，很安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘟嘟要連上模型才能陪你聊天。點下面的按鈕，把模型服務商給你的地址、鑰匙和模型名填進來就行，存在你手機裏，很安全。"
          }
        }
      }
    },

    "napp.appleMusic.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the songs you request in the music room. Same authorization as the music room."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听歌房播你点播的歌。授权状态和听歌房是同一份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽歌房播你點播的歌。授權狀態和聽歌房是同一份。"
          }
        }
      }
    },

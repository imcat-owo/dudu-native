    "apigroup.pgroups.deleteConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%1$@\"? The connections inside stay untouched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删掉「%1$@」？里面的连接不会动。"
          }
        },
        "zh-Hant": {

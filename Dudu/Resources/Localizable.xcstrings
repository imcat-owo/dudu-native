    "outreach.freq.quietDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only mentions things when you open the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你打开时提起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你打開時提起"
          }
        }
      }
    },
    "outreach.freq.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When he reaches out to you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他什么时候主动找你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他什麼時候主動找你"
          }
        }
      }
    },
    "outreach.notif.anniversary.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" is in %2$@ days — I am quietly preparing a little surprise"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」还有 %2$@ 天，我在偷偷准备小惊喜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」還有 %2$@ 天，我在偷偷準備小驚喜"
          }
        }
      }
    },
    "outreach.notif.anniversary.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想你了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想你了"
          }
        }
      }
    },
    "outreach.notif.diaryNudge.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" — I want to write it down. You write, or shall I?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」——想把它记下来，你写还是我写？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」——想把它記下來，你寫還是我寫？"
          }
        }
      }
    },
    "outreach.notif.diaryNudge.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day came back to me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那天又想起来了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那天又想起來了"
          }
        }
      }
    },
    "outreach.notif.feedNudge.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liked it and left you a reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去给你点了赞，留了言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去給你點了讚，留了言"
          }
        }
      }
    },
    "outreach.notif.feedNudge.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saw your post"
          }
        },
        "zh-Hans": {

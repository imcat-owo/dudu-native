    "openapp.auth.reason": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked to visit %1$@ — this leaves 嘟嘟 and opens that app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你要去「%1$@」看看，这会离开嘟嘟，跳到那个 App 里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你要去「%1$@」看看，這會離開嘟嘟，跳到那個 App 裏。"
          }
        }
      }
    },
    "openapp.error.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "She didn't allow opening %1$@ — I stayed put."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "她没同意打开「%1$@」，我没跳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "她沒同意打開「%1$@」，我沒跳。"
          }
        }
      }
    },
    "openapp.error.noWebVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no web version — it can only be opened by jumping out (needs her approval)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」没有网页版，只能跳出去打开（需要她同意）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」沒有網頁版，只能跳出去打開（需要她同意）。"
          }
        }
      }
    },
    "openapp.error.notInstalled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ doesn't seem to be installed — couldn't open it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」好像没装在手机上，打不开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」好像沒裝在手機上，打不開。"
          }
        }
      }
    },
    "openapp.error.unknownEntry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No such fixed path (%1$@). I can only use the whitelisted entries — I can't invent URLs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有这个固定路径（%1$@）。我只能用白名单里的，不能现编 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有這個固定路徑（%1$@）。我只能用白名單裏的，不能現編 URL。"
          }
        }
      }
    },
    "openapp.result.opened": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened %1$@. %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经打开「%1$@」。%2$@"

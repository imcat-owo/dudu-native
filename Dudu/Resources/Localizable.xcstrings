    "selfpost.section.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At a few quiet moments each day, he decides whether he has something worth sharing to the feed. No pings — you'll find it when you open Our Space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天几个安静时刻，他自己决定有没有值得发到动态里的事。不打扰你——你打开我们的空间时自然会看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天幾個安靜時刻，他自己決定有沒有值得發到動態裡的事。不打擾你——你打開我們的空間時自然會看到。"
          }
        }
      }
    },

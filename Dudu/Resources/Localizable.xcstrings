    "openapp.result.watchdogArmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchdog armed: in %1$@ minutes I'll remind her — tapping it brings her back to this dialog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看门狗已就位：%1$@ 分钟后我会提醒她，点通知就带她回这个对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看門狗已就位：%1$@ 分鐘後我會提醒她，點通知就帶她回這個對話。"
          }
        }
      }
    },
    "openapp.result.watchdogFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchdog failed to arm — if she wants to come back, she can switch back to 嘟嘟 herself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看门狗没能就位，她想回来可以自己切回嘟嘟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看門狗沒能就位，她想回來可以自己切回嘟嘟。"
          }
        }
      }
    },
    "openapp.result.webview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened %1$@ in the in-app browser (%2$@) — she never left 嘟嘟."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在应用内浏览器打开（%1$@）：%2$@，她没离开嘟嘟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在應用內瀏覽器打開（%1$@）：%2$@，她沒離開嘟嘟。"
          }
        }
      }
    },
    "openapp.watch.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How's %1$@ treating you? Tap me and I'll bring you back to 嘟嘟."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」那边还顺利吗？点我，我带你回嘟嘟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」那邊還順利嗎？點我，我帶你回嘟嘟。"
          }
        }
      }
    },
    "openapp.watch.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How's it going?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩得怎么样？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "玩得怎麼樣？"
          }
        }
      }
    },

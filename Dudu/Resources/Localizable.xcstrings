    "dials.section.aiNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can drag these. He may suggest a change in chat, but he can never adjust them himself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能拖这些滑杆。他可以在聊天里建议，但自己调不了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能拖這些滑桿。他可以在聊天裡建議，但自己調不了。"
          }
        }
      }
    },
    "dials.section.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the dials — he changes right away, no restart. His next reply already follows them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑杆，他立刻就变，不用重启。下一句回复就按新的来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動滑桿，他立刻就變，不用重啟。下一句回覆就按新的來。"
          }
        }
      }
    },

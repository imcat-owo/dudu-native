    "apigroup.caching.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the server supports it, repeated prompts hit the cache — faster and cheaper. OpenAI-compatible endpoints only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端支持的话，重复的提示词直接读缓存，又快又省钱。只对 OpenAI 兼容接口有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務端支持的話，重複的提示詞直接讀緩存，又快又省錢。只對 OpenAI 兼容接口有效。"
          }
        }
      }
    },

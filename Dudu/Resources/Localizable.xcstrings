          }
        }
      }
    },
    "perm.why.bluetooth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan for and connect to Bluetooth devices near her, like speakers or headphones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来搜索并连接她身边的蓝牙设备，比如音响、耳机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來搜索並連接她身邊的藍牙設備，比如音響、耳機。"
          }
        }
      }
    },
    "perm.why.clipboard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read copied content so the AI can work with it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来读取她复制的内容，帮她处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來讀取她複製的內容，幫她處理。"
          }
        }
      }
    },
    "perm.why.location": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To get the current location for location-aware help."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来获取当前位置，提供和位置相关的帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來獲取當前位置，提供和位置相關的幫助。"
          }
        }
      }
    },
    "perm.why.notifications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To alert her when something important happens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来在重要事情发生时提醒她。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來在重要事情發生時提醒她。"
          }
        }
      }
    },
    "perm.why.open_apps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the AI can take her to other apps (maps, music, shops) when she asks — always with her tap to confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 能在她要求时带她去别的 App（地图、音乐、购物），每次都要她点一下确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 AI 能在她要求時帶她去別的 App（地圖、音樂、購物），每次都要她點一下確認。"
          }
        }
      }
    },
    "perm.why.photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read photos she picks, so the AI can see or use them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来读取她选择的照片，发给 AI 看或使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來讀取她選擇的照片，發給 AI 看或使用。"
          }
        }
      }
    },
    "perm.why.sandbox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the AI can run commands and code for her in the sandbox."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 能在沙箱里帮她跑命令、跑代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 AI 能在沙箱裏幫她跑命令、跑代碼。"
          }
        }
      }
    },

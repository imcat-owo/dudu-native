    "outreach.notif.loveLetter.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I wrote you a letter. It is in Our Space — do not keep it waiting too long"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我给你写了封信，在我们的空间里，别让它等太久"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我給你寫了封信，在我們的空間裏，別讓它等太久"
          }
        }
      }
    },

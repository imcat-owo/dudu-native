    },
    "story.section.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stories you write together — he narrates, you steer. Every story and its bible live here, pausable and deletable anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们一起写的故事——他讲，你来定走向。每个故事和它的设定集都在这里，随时可以暂停、删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們一起寫的故事——他講，你來定走向。每個故事和它的設定集都在這裡，隨時可以暫停、刪除。"
          }
        }
      }
    },

    "perm.aiDesc.bluetooth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth: scan for and connect to Bluetooth devices near her (e.g. speakers, headphones). This leaves the app — you MUST ask her first every time and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙：搜索并连接她身边的蓝牙设备（比如音响、耳机）。这是跨出 App 的操作，每次使用前必须先问她，得到允许才能做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙：搜索並連接她身邊的藍牙設備（比如音響、耳機）。這是跨出 App 的操作，每次使用前必須先問她，得到允許才能做。"
          }
        }
      }
    },
    "perm.aiDesc.clipboard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard: read what she copied. The clipboard may hold passwords and other sensitive info — you MUST ask her first every time and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板：读取她复制的内容。剪贴板里可能有密码等敏感信息，每次读取前必须先问她，得到允许才能做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼板：讀取她複製的內容。剪貼板裏可能有密碼等敏感信息，每次讀取前必須先問她，得到允許才能做。"
          }
        }
      }
    },
    "perm.aiDesc.location": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location: get her current position. This is sensitive private data — you MUST ask her first every time and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位：获取她当前所在的位置。这是敏感隐私，每次获取前必须先问她，得到允许才能做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定位：獲取她當前所在的位置。這是敏感隱私，每次獲取前必須先問她，得到允許才能做。"
          }
        }
      }
    },
    "perm.aiDesc.notifications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications: send her system notifications. Never pester her — you MUST ask her first every time and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知：给她发系统通知。不要打扰她，每次发送前必须先问她，得到允许才能做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知：給她發系統通知。不要打擾她，每次發送前必須先問她，得到允許才能做。"
          }
        }
      }
    },
    "perm.aiDesc.open_apps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open other apps: jump out of 嘟嘟 to a whitelisted app (maps, music, shop, Shortcuts…). This leaves 嘟嘟 — you MUST ask her first every time (the tool pops the approval) and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开别的 App：从嘟嘟跳到白名单里的应用（地图、音乐、购物、快捷指令……）。这会离开嘟嘟，每次都必须先问她（工具会弹窗），得到允许才能跳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開別的 App：從嘟嘟跳到白名單裏的應用（地圖、音樂、購物、快捷指令……）。這會離開嘟嘟，每次都必須先問她（工具會彈窗），得到允許才能跳。"
          }
        }
      }
    },
    "perm.aiDesc.photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo library: read photos from her phone. These are her private photos — you MUST ask her first every time and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册：读取她手机相册里的照片。这是她的私人照片，每次读取前必须先问她，得到允许才能做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相冊：讀取她手機相冊裏的照片。這是她的私人照片，每次讀取前必須先問她，得到允許才能做。"
          }
        }
      }
    },
    "perm.aiDesc.sandbox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox: run shell commands in her cloud Docker containers or the local Linux sandbox. This runs real code on her machines — you MUST ask her first every time and only proceed with her permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱：在她云服务器的 Docker 容器或本地 Linux 沙箱里运行 shell 命令。这是在她的机器上跑真实代码，每次运行前必须先问她，得到允许才能做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱：在她雲服務器的 Docker 容器或本地 Linux 沙箱裏運行 shell 命令。這是在她的機器上跑真實代碼，每次運行前必須先問她，得到允許才能做。"
          }
        }
      }
    },
    "perm.bluetoothNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth scanning needs the system Bluetooth permission on first use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次使用蓝牙扫描需要系统蓝牙权限。"

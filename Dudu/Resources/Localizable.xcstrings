    "napp.shazam.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hear something nice? Ask me what it is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听到好听的歌，问我这是什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

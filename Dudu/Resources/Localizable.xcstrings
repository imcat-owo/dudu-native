    "capgroup.routingDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, messages with images or voice are routed to the matching group; the current model is always tried first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，带图片或语音的消息会路由到对应分组；总是先试当前模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啓後，帶圖片或語音的消息會路由到對應分組；總是先試當前模型。"
          }
        }
      }
    },
    "capgroup.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route images, voice and generation tasks to the right models. Input groups = routing (a message with an image goes to the image group); output groups = tool backends (image/video generation calls the group's endpoint)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把图片、语音和生成任务路由到合适的模型。输入型分组=路由（带图片的消息走图片分组）；输出型分组=工具后端（生成图片/视频时调用分组的接口）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把圖片、語音和生成任務路由到合適的模型。輸入型分組=路由（帶圖片的消息走圖片分組）；輸出型分組=工具後端（生成圖片/視頻時調用分組的接口）。"
          }
        }
      }
    },
    "capgroup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capability groups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能力分组"

    "apigroup.pgroups.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort connections into your own buckets — tag a group with the same name and it lands here automatically. When the active connection gets rate-limited or goes down, it automatically fails over to the next one in its bucket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给连接分几个自己的篮子，编辑分组时打上同名标签就自动归进去。当前连接被限流或挂掉时，会自动切到同篮子的下一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給連接分幾個自己的籃子，編輯分組時打上同名標籤就自動歸進去。當前連接被限流或掛掉時，會自動切到同籃子的下一個。"
          }
        }
      }
    },

    "globalmd.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferences you write yourself — the AI only reads. e.g. I don't eat spicy food."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你亲手写的偏好，AI 只读不改。比如：我不吃辣、回消息别太长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你親手寫的偏好，AI 只讀不改。比如：我不喫辣、回消息別太長。"
          }
        }
      }
    },
    "globalmd.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write your preferences here…\n\n e.g.:\n- I don't eat spicy food\n- Don't wake me early on weekends\n- Keep replies short"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里写下你的偏好…\n\n比如：\n- 我不吃辣\n- 周末别叫我早起\n- 回消息简短点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裏寫下你的偏好…\n\n比如：\n- 我不喫辣\n- 週末別叫我早起\n- 回消息簡短點"
          }
        }
      }
    },

    "crossapp.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in other apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 App 里打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 App 裡打開"
          }
        }
      }
    },
    "crossapp.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the app through its URL scheme — the same mechanism as the AI's apple-open. Dudu can't see what happens inside the other app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 URL Scheme 打开对应 App——跟 AI 用的 apple-open 是同一套机制。嘟嘟看不到别的 App 里发生了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 URL Scheme 打開對應 App——跟 AI 用的 apple-open 是同一套機制。嘟嘟看不到別的 App 裡發生了什麼。"
          }
        }
      }
    },

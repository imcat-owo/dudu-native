    "adapt.contextCompacted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The context was too long, so I trimmed it and retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文太长了，我精简一下再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文太長了，我精簡一下再試一次。"
          }
        }
      }
    },
    "adapt.thinkingOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model doesn't support thinking display, so I turned it off and retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个模型不支持思考过程显示，我先关掉再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個模型不支持思考過程顯示，我先關掉再試一次。"
          }
        }
      }
    },
    "adapt.toolsOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

    "Siri & Shortcuts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri & Shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 与捷径"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 與捷徑"
          }
        }
      }
    },
    "Dudu lives in the Shortcuts app too. Seven voice shortcuts work out of the box — just say the phrase and Dudu gets moving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dudu lives in the Shortcuts app too. Seven voice shortcuts work out of the box — just say the phrase and Dudu gets moving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嘟嘟也住在捷径 App 里。七个语音捷径开箱即用——喊出口令，嘟嘟就开工。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘟嘟也住在捷徑 App 裡。七個語音捷徑開箱即用——喊出口令，嘟嘟就開工。"
          }
        }
      }
    },
    "Apple doesn't let apps record their own Siri phrases, so Add to Siri opens the Shortcuts app — give any action a phrase of your own there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple doesn't let apps record their own Siri phrases, so Add to Siri opens the Shortcuts app — give any action a phrase of your own there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果不允许 App 自己录制 Siri 口令，所以「添加到 Siri」会打开捷径 App——在那里给任何动作起一个自己的口令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蘋果不允許 App 自己錄製 Siri 口令，所以「加入到 Siri」會打開捷徑 App——在那裡給任何動作起一個自己的口令。"
          }
        }
      }
    },
    "Siri phrases": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

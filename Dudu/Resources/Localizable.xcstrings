    "voice.emotionTtsDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, his voice follows the feeling of what he's saying — quicker when happy, slower and lower when sad. Only the default voice and some providers can do this; trust your ears."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后，他说话的语气会跟着内容走：开心快一点，难过慢一点、沉一点。只有默认语音和部分服务商吃这套，效果以你听到的为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開後，他說話的語氣會跟著內容走：開心快一點，難過慢一點、沉一點。只有預設語音和部分服務商吃這套，效果以你聽到的為準。"
          }
        }
      }
    },

    "browser.cookieNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only JS-readable cookies are shown. HttpOnly cookies are invisible and can't be cleared — those are the site's own secrets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能看到 JS 能读到的 cookie，HttpOnly 的既看不到也清不掉——那是网站自己的小秘密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能看到 JS 能讀到的 cookie，HttpOnly 的既看不到也清不掉——那是網站自己的小祕密。"
          }
        }
      }

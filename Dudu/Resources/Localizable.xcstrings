    },
    "backup.restoreFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restore didn't finish — some things may be half-restored. Try restoring again; re-running is safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复没做完，东西可能只回来了一半。再恢复一次试试，重复恢复是安全的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復沒做完，東西可能只回來了一半。再恢復一次試試，重複恢復是安全的。"
          }
        }
      }
    },
    "backup.secretsNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excludes: API keys, custom request headers, custom voice keys (re-enter after restore); secret query params are stripped from URLs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不含：API 密钥、自定义请求头、自定义语音密钥（恢复后需重新填写）；网址里的密钥参数会被移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不含：API 密鑰、自定義請求頭、自定義語音密鑰（恢復後需重新填寫）；網址裏的密鑰參數會被移除"
          }
        }
      }
    },

    "sandbox.relayMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server doesn't have the relay installed yet. It has to be installed on your server, which the AI can't reach — the install steps are below, just copy, paste and run them. About 2 minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器上还没装传话员。传话员得装在你的服务器上，AI 够不着——下面是安装步骤，复制粘贴跑一下就行，2 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器上還沒裝傳話員。傳話員得裝在你的伺服器上，AI 夠不著——下面是安裝步驟，複製貼上跑一下就行，2 分鐘。"
          }
        }
      }
    },
    "sandbox.relayNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud mode needs the relay installed on your server first (once is enough). Don't feel like filling the form? Just tell %1$@ to connect your cloud server — he'll fill it in and you just confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端连接要在你的服务器上先装一个传话员（装一次就行）。嫌手填麻烦？直接跟%1$@说「连我的云服务器」，他填好、你点确认就行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端連接要在你的伺服器上先裝一個傳話員（裝一次就行）。嫌手填麻煩？直接跟%1$@說「連我的雲伺服器」，他填好、你點確認就行。"
          }
        }
      }
    },

    "evolution.list.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing learned yet. When he notices a pattern across days, it'll show up here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没学到什么。他注意到你们相处里的规律时，会记在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒學到什麼。他注意到你們相處裡的規律時，會記在這裡。"
          }
        }
      }
    },
    "evolution.section.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What he's learned about being with you — every note cites where it came from. Each is editable and deletable anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他跟你相处中学到的东西——每条都标着出处，随时可改可删。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他跟你相處中學到的東西——每條都標著出處，隨時可改可刪。"
          }
        }
      }
    },
    "evolution.section.persona": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给 "
          }

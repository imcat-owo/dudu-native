    "napp.homekit.setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs the native HomeKit module, not bundled in this build yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接原生 HomeKit 模块，这个版本还没装。装好就能用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要接原生 HomeKit 模塊，這個版本還沒裝。裝好就能用。"
          }
        }
      }
    },
    "napp.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native capabilities Apple lets apps request. I can only help once you allow them — your call."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是苹果允许 App 申请的原生能力。开了我才能帮你，用不用你说了算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是蘋果允許 App 申請的原生能力。開了我才能幫你，用不用你說了算。"
          }
        }
      }
    },

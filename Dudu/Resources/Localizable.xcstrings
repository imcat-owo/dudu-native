    "sandbox.testConnectionNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test opens a real SSH session through the relay with the credentials above — nothing is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试会用上面填的账号信息，经传话员真的打开一次 SSH 会话——什么都不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試會用上面填的帳號資訊，經傳話員真的打開一次 SSH 會話——什麼都不會保存。"
          }
        }
      }
    },
    "sandbox.testOk": {

    "voice.cache.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthesized speech and podcasts pile up here. Anything untouched for 30 days gets quietly swept on launch — or clean it now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合成过的语音和播客会留在这里占地方。30 天没碰过的，开 App 时我会悄悄清掉；你也可以现在动手清。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合成過的語音和播客會留在這裏佔地方。30 天沒碰過的，開 App 時我會悄悄清掉；你也可以現在動手清。"
          }
        }
      }
    },

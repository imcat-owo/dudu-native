    "backup.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export everything in one tap; restore after reinstall. API keys are never included — re-enter them after restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键导出全部数据，换机或重装后可恢复。备份不含 API 密钥，恢复后需重新填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵導出全部數據，換機或重裝後可恢復。備份不含 API 密鑰，恢復後需重新填寫。"
          }
        }
      }
    },

    "outreach.freq.activeDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaches out more often"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更愿意主动找你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更願意主動找你"
          }
        }
      }
    },
    "outreach.freq.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When there is something worth saying, he will message you himself. Never out of nowhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有值得说的事时，他会主动给你发消息。从不无缘无故打扰你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有值得說的事時，他會主動給你發消息。從不無緣無故打擾你。"
          }
        }
      }
    },
    "outreach.freq.moderate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanced"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適度"
          }
        }
      }
    },
    "outreach.freq.moderateDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for things that matter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重要的事才找你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重要的事才找你"
          }
        }
      }
    },
    "outreach.freq.quiet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜"
          }

    "evolution.actions.resetBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every growth note for this persona. He'll go back to how his card describes him. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删掉这个人设的全部成长记录，他会回到人设卡里写的样子。这个操作不能撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪掉這個人設的全部成長記錄，他會回到人設卡裡寫的樣子。這個操作不能撤銷。"
          }
        }
      }
    },
